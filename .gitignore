# scratch output: every STL/3MF/JSON/PNG a run produces
out/*
!out/.gitkeep

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
build/
dist/

# nTop runner notebooks are build products: `api build <recipe>` regenerates them from ntop/recipes/
# and stamps them (<name>.build.json, committed); the solitaire ones passed GitHub's 100 MB limit on
# 2026-11-03 (230 MB each with the per-bar opening's cached meshes). The block library stays tracked.
ntop/notebooks/*.ntop

# nTop / Blender scratch
*.blend1
*.blend2
ntopcl.log
input_template.json
output_template.json

# OS
Thumbs.db
.DS_Store
